using namespace std;

// Dynamic Stack for numbers
class Stack
{
private:
    double* arr;
    int top;
    int size;

public:

    Stack(int s)
    {
        size = s;
        arr = new double[size];
        top = -1;
    }

    void push(double value)
    {
        if (top == size - 1)
            return;

        top++;
        arr[top] = value;
    }

    double pop()
    {
        if (top == -1)
            return 0;

        double value = arr[top];
        top--;

        return value;
    }

    bool isEmpty()
    {
        return top == -1;
    }

    ~Stack()
    {
        delete[] arr;
    }
};

// Evaluate postfix
double evaluatePostfix(string postfix)
{
    Stack s(postfix.length());

    double values[26];

    // Take values of variables
    for (int i = 0; i < 26; i++)
    {
        values[i] = 0;
    }

    // We will ask values when variable appears
    bool entered[26] = {false};

    for (int i = 0; i < postfix.length(); i++)
    {
        char ch = postfix[i];

        // If operand is a variable
        if (ch >= 'A' && ch <= 'Z')
        {
            int index = ch - 'A';

            // Ask value only first time
            if (!entered[index])
            {
                cout << "Enter value of " << ch << ": ";
                cin >> values[index];

                entered[index] = true;
            }

            s.push(values[index]);
        }

        // If operator
        else
        {
            double second = s.pop();
            double first = s.pop();

            double result;

            if (ch == '+')
                result = first + second;

            else if (ch == '-')
                result = first - second;

            else if (ch == '*')
                result = first * second;

            else if (ch == '/')
                result = first / second;

            else
                result = 0;

            // Put result back into stack
            s.push(result);
        }
    }

    return s.pop();
}

int main()
{
    string postfix;

    cout << "Enter postfix expression: ";
    cin >> postfix;

    double answer = evaluatePostfix(postfix);

    cout << "Result = " << answer;

    return 0;
}
