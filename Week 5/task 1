#include <iostream>
using namespace std;

// Dynamic Stack
class Stack
{
private:
    char* arr;
    int top;
    int size;

public:
    // Constructor
    Stack(int s)
    {
        size = s;
        arr = new char[size];
        top = -1;
    }

    // Push a character
    void push(char value)
    {
        if (top == size - 1)
        {
            cout << "Stack Overflow";
            return;
        }

        top++;
        arr[top] = value;
    }

    // Return top character
    char peek()
    {
        return arr[top];
    }

    // Remove top character
    void pop()
    {
        if (top != -1)
            top--;
    }

    // Check whether stack is empty
    bool isEmpty()
    {
        return top == -1;
    }

    // Destructor
    ~Stack()
    {
        delete[] arr;
    }
};

// Check matching brackets
bool isMatching(char open, char close)
{
    if (open == '(' && close == ')')
        return true;

    if (open == '[' && close == ']')
        return true;

    if (open == '{' && close == '}')
        return true;

    return false;
}

// Check balanced brackets
bool isBalanced(string expression)
{
    Stack s(expression.length());

    for (int i = 0; i < expression.length(); i++)
    {
        char ch = expression[i];

        // Opening brackets are pushed
        if (ch == '(' || ch == '[' || ch == '{')
        {
            s.push(ch);
        }

        // Closing brackets
        else if (ch == ')' || ch == ']' || ch == '}')
        {
            // No opening bracket available
            if (s.isEmpty())
                return false;

            // Check whether brackets match
            if (!isMatching(s.peek(), ch))
                return false;

            // Remove matched opening bracket
            s.pop();
        }
    }

    // Stack must be empty at the end
    return s.isEmpty();
}

int main()
{
    string expression;

    cout << "Enter brackets: ";
    cin >> expression;

    if (isBalanced(expression))
        cout << "Balanced";
    else
        cout << "Not Balanced";

    return 0;
}
